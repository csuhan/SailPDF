{
  "name": "sail-pdf",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.11.1",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "An open-source PDF workspace for macOS: reading, annotations, editing and optional on-device AI.",
  "author": {
    "name": "csuhan",
    "url": "https://github.com/csuhan"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs && node scripts/generate-icons.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/generate-legal-notices.mjs && tsc -b && vite build",
    "test": "node scripts/run-tests.mjs --unit",
    "test:regressions": "node scripts/run-tests.mjs --regressions",
    "test:e2e": "node scripts/run-tests.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "app": "npm run icons && npm run build && electron .",
    "app:dir": "npm run app:prepare && npm run build && electron-builder --mac dir --arm64",
    "app:dmg": "npm run app:prepare && npm run build && electron-builder --mac dmg --arm64",
    "icons": "node scripts/generate-icons.mjs",
    "build:ocr": "node scripts/build-ocr.mjs",
    "test:fixtures": "node scripts/prepare-test-fixtures.mjs",
    "test:native": "electron scripts/native-release-security.cjs",
    "format": "prettier --write src electron locales scripts docs .github *.json *.md *.yml",
    "format:check": "prettier --check src electron locales scripts docs .github *.json *.md *.yml",
    "app:prepare": "node scripts/fetch-llama.mjs && npm run build:ocr && npm run icons",
    "check:publication": "node scripts/check-publication.mjs",
    "build:website": "node scripts/build-website.mjs",
    "check:website": "node scripts/build-website.mjs --check",
    "test:website": "node scripts/test-website-seo.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "mammoth": "1.13",
    "marked": "^18.1.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.6.3",
    "vite": "6.4.5"
  },
  "homepage": "https://sailpdf.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csuhan/SailPDF.git"
  },
  "bugs": {
    "url": "https://github.com/csuhan/SailPDF/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
